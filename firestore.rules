rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Role Verification Helpers ───────────────────────────────────────────
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isAdminUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPrivileged() {
      return isSuperAdmin() || isAdminUser();
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─── User Profile & Subcollections ───────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isPrivileged();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isPrivileged();
      }
    }

    // ─── Products & Catalog ──────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /trash/{trashId} {
      allow read, write: if isPrivileged();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /subcategories/{subId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /collections/{colId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /countries/{countryId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Blogs & Articles ────────────────────────────────────────────────────
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Tags ────────────────────────────────────────────────────────────────
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Gallery ─────────────────────────────────────────────────────────────
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Reviews ─────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isPrivileged();
    }

    // ─── Newsletter Subscribers ──────────────────────────────────────────────
    match /newsletter/{subId} {
      allow read: if isPrivileged();
      allow create: if true;
      allow update, delete: if isPrivileged();
    }

    // ─── Coupons & Promotions ────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Orders ──────────────────────────────────────────────────────────────
    // Public creation allows guest & user checkout.
    // Reading is strictly limited to the order owner or verified administrators.
    // Price and payment status can never be tampered with by clients.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isPrivileged() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow update: if isPrivileged() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'orderStatus', 'razorpayPaymentId', 'total']))
      );
      allow delete: if isPrivileged();
    }

    // ─── Site Settings & World Edits ─────────────────────────────────────────
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /world_edits_carousel/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    match /header_world_edits/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Announcements ───────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // ─── Stock Notifications ─────────────────────────────────────────────────
    match /stock_notifications/{docId} {
      allow create: if true;
      allow read, update, delete: if isPrivileged();
    }

    // ─── Admin Roles (Restricted to Privileged Accounts) ──────────────────────
    match /admins/{adminId} {
      allow read: if isPrivileged();
      allow write: if isSuperAdmin();
    }

    match /superadmins/{superAdminId} {
      allow read: if isPrivileged();
      allow write: if isSuperAdmin();
    }
  }
}
