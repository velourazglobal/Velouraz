{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/create-razorpay-order",
      "destination": "/api/create-order"
    },
    {
      "source": "/api/order-status",
      "destination": "/api/verify-payment"
    },
    {
      "source": "/api/send-otp",
      "destination": "/api/otp?action=send"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/otp?action=verify"
    },
    {
      "source": "/api/send-order-email",
      "destination": "/api/send-email?type=order"
    },
    {
      "source": "/api/send-admin-credentials",
      "destination": "/api/send-email?type=admin"
    },
    {
      "source": "/api/send-shipping-email",
      "destination": "/api/send-email?type=shipping"
    },
    {
      "source": "/api/shiprocket",
      "destination": "/api/shiprocket"
    },
    {
      "source": "/api/shiprocket-webhook",
      "destination": "/api/shiprocket?action=webhook"
    },
    {
      "source": "/api/cloudinary/delete",
      "destination": "/api/cloudinary-delete"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
