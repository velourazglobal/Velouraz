# ═══════════════════════════════════════════════════════════════════
#  VELOURAZ — Environment Variables Template
#
#  HOW TO USE:
#  1. Copy this file: cp .env.example .env
#  2. Fill in your real values in .env
#  3. NEVER commit .env to Git — it's in .gitignore
#
#  FOR VERCEL DEPLOYMENT:
#  Add every variable below to:
#  Vercel Dashboard → Your Project → Settings → Environment Variables
#  Select: Production + Preview + Development for each variable
# ═══════════════════════════════════════════════════════════════════

# ─── FIREBASE (Client-side — VITE_ prefix required) ─────────────
# Source: Firebase Console → Project Settings → General → Your Apps → SDK Setup
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── CLOUDINARY (Client-side — VITE_ prefix required) ───────────
# Source: Cloudinary Console → Settings → Upload Presets
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─── CLOUDINARY (Server-side — Vercel API functions only) ────────
# Source: Cloudinary Console → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── SMTP / EMAIL (Server-side only) ─────────────────────────────
# For Gmail: Create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="Your Brand Name" <no-reply@yourdomain.com>

# ─── ADMIN EMAIL ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ─── RAZORPAY ─────────────────────────────────────────────────────
# Source: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_ keys for testing, rzp_live_ for production
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── OTP SECURITY ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=your_random_64_char_hex_string

# ─── SITE URL ─────────────────────────────────────────────────────
VITE_SITE_URL=https://www.yourdomain.com
